{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-risk-workbench.dev/schemas/scenario-card.schema.json",
  "title": "Scenario Card",
  "type": "object",
  "required": ["id", "version", "synthetic", "baseState", "targets"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "synthetic": { "const": true },
    "description": { "type": "string" },
    "baseState": { "type": "object" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
