{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-risk-workbench.dev/schemas/knowledge-claim.schema.json",
  "title": "Knowledge Claim",
  "type": "object",
  "required": ["id", "statement", "status", "supports"],
  "properties": {
    "id": { "type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PUBLIC", "SYNTHETIC_VERIFIED", "DISPUTED", "UNKNOWN", "REJECTED"] },
    "supports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
