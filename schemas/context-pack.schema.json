{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-risk-workbench.dev/schemas/context-pack.schema.json",
  "title": "Scenario Context Pack",
  "type": "object",
  "required": ["id", "scenario", "graph", "evidence", "governance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "scenario": {
      "type": "object",
      "required": ["id", "version", "synthetic", "targets"]
    },
    "graph": {
      "type": "object",
      "required": ["graphHash", "hashAlgorithm", "nodes", "edges", "topologicalOrder"]
    },
    "evidence": { "type": "array", "minItems": 1 },
    "governance": {
      "type": "object",
      "required": ["productionAuthority", "synthetic", "unresolvedQuestions"],
      "properties": {
        "productionAuthority": { "const": false },
        "synthetic": { "const": true },
        "unresolvedQuestions": { "type": "array" }
      }
    }
  }
}
