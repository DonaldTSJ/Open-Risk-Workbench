{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-risk-workbench.dev/schemas/knowledge-document.schema.json",
  "title": "Knowledge Document",
  "type": "object",
  "required": ["id", "title", "sourceKind", "license", "claims"],
  "properties": {
    "id": { "type": "string", "pattern": "^DOC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "sourceKind": { "enum": ["PUBLIC", "SYNTHETIC_DESIGN"] },
    "license": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "knowledge-claim.schema.json" }
    }
  },
  "additionalProperties": false
}
