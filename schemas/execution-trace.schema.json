{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-risk-workbench.dev/schemas/execution-trace.schema.json",
  "title": "Execution Trace",
  "type": "object",
  "required": ["graphHash", "outputs", "trace"],
  "properties": {
    "graphHash": { "type": "string", "minLength": 1 },
    "outputs": { "type": "object" },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "kind", "value", "unit", "expression"]
      }
    }
  }
}
